# ==========================================
# AI Model Benchmark Suite - Configuration
# ==========================================
# Инструкция:
# 1. Скопируйте этот файл и назовите его .env
# 2. Заполните значения под вашу конфигурацию

# --- Основные настройки ---

# Провайдер моделей: lmstudio или ollama
PROVIDER=ollama

# Тип бенчмарка: coding (код) или assistant (ассистент)
BENCHMARK_MODE=coding

# Название модели. Должно точно совпадать с названием в провайдере.
# Примеры: llama3.2, qwen2.5:7b, mistral
MODEL_NAME=llama3.2

# --- Настройки подключения ---

# URL API. 
# Важно: Для Docker-контейнера обычно нужно использовать host.docker.internal,
# чтобы контейнер мог достучаться до локального сервера на вашем ПК.
# LM Studio: http://host.docker.internal:1234/v1
# Ollama:    http://host.docker.internal:11434/api
API_BASE_URL=http://host.docker.internal:11434/api

# Тип API. 
# 'ollama' - для нативного API Ollama.
# 'openai_compat' - для LM Studio или Ollama (если включен режим v1 API).
API_TYPE=ollama

# API Key. Для локальных провайдеров обычно не требуется (можно оставить dummy).
API_KEY=dummy

# --- Производительность ---

# Таймаут генерации ответа от модели (в секундах).
# Для 7B моделей достаточно 60-120 сек.
# Для 14B-30B моделей рекомендуется 300+ сек.
TIMEOUT_GEN=120